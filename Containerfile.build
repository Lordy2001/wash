# Source build used by the wash-web.build quadlet (deploy/quadlet). Builder tag pinned.
FROM docker.io/library/golang:1.27.4-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /wash-web ./cmd/wash-web

FROM scratch
COPY --from=build /wash-web /wash-web
USER 65532:65532
VOLUME /var/lib/wash
ENV WASH_DATA=/var/lib/wash WASH_LISTEN=0.0.0.0:8443 HOME=/var/lib/wash TMPDIR=/var/lib/wash
EXPOSE 8443
ENTRYPOINT ["/wash-web"]
CMD ["serve"]
