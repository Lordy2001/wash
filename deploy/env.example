# %h/wash-web/.env  (mode 0600, owner wash) — loaded by wash-web.container
#
# Origins browsers use, comma separated (tailnet: MagicDNS name). Passkeys are bound to the
# host name (RP ID), never an IP address. Every name users will type must be listed here.
WASH_ORIGIN=https://ca-data.tailnet.local:8443,https://ca-data:8443
# Extra names/IPs in the self-signed certificate (washd pins it at `wash enroll`).
WASH_TLS_HOSTS=ca-data.tailnet.local,ca-data
# auto = self-signed in /var/lib/wash/tls | off = plain HTTP behind Caddy | CERT,KEY paths
WASH_TLS=auto
# open | closed  (closed: no passkey creation from the website)
WASH_REGISTRATION=open
# 1 only behind a proxy that sets X-Forwarded-For (Caddy); never when exposed directly
WASH_TRUST_PROXY=0
