# %h/wash-web/.env  (mode 0600, owner wash) — loaded by wash-web.container
#
# Origins browsers use, comma separated (tailnet: MagicDNS name). Passkeys are bound to the
# host name (RP ID), never an IP address. Every name users will type must be listed here.
WASH_ORIGIN=https://ca-data.tailnet.local:8443,https://ca-data:8443
# Extra names/IPs in the self-signed certificate (washd pins it at `wash enroll`).
WASH_TLS_HOSTS=ca-data.tailnet.local,ca-data
# auto = self-signed in /var/lib/wash/tls | off = plain HTTP behind Caddy | CERT,KEY paths
WASH_TLS=auto
# closed: passkeys can be created only while their user has run `wash keys open` (1h max)
# open:   anyone can create (pending) passkeys for any user name at any time
WASH_REGISTRATION=closed
# Extra user names that may never use wash, on top of the built-in list (root, ubuntu, pi,
# system names, ...). Put this host's service users here, e.g. the rootless podman ones:
#   awk -F: '$7 ~ /nologin|false/ && $3 >= 1000 {printf "%s,", $1}' /etc/passwd
WASH_DENY_USERS=
# Behind a reverse proxy: its IPs/CIDRs (comma separated); X-Forwarded-For/-Proto are
# believed only from them. 1 = any peer (only with the port published on 127.0.0.1).
# 0 when browsers connect directly.
WASH_TRUST_PROXY=0
# Public base URL (no trailing slash). `wash watch host` prints WASH_PUBLIC_URL/playback/UUID;
# without it the link uses the URL washd enrolled with (often an internal name).
WASH_PUBLIC_URL=https://ca.ffeineaddiction.com/wash
# Largest recording `wash watch host` may publish, in MiB (default 512).
#WASH_PLAYBACK_MAX_MB=512
